from enaml.layout.api import hbox, align, spacer, vbox
from enaml.widgets.api import Container, Form, Label, CheckBox, SpinBox
from enaml.qt.QtWidgets import QApplication


enamldef PreviewSettingsPage(Container):
    padding = 0
    attr model
    Form:
        Label:
            text = QApplication.translate("settings", "Grid")
        Container:
            constraints = [
                hbox(gx, gy, lb, ga),
                align('v_center', gx, gy, lb, ga)
            ]

            CheckBox: gx:
                text = QApplication.translate("settings", "X")
                checked := model.show_grid_x
            CheckBox: gy:
                text = QApplication.translate("settings", "Y")
                checked := model.show_grid_y
            Label: lb:
                text = QApplication.translate("settings", "Alpha")
            SpinBox: ga:
                value := model.grid_alpha

        Label:
            text = QApplication.translate("settings", "Layers")
        Container:
            constraints = [
                vbox(sc, st, sw, so, sf, sl),
            ]
            CheckBox: sc:
                text = QApplication.translate("settings", "Cuts")
                checked := model.show_cuts
            CheckBox: st:
                text = QApplication.translate("settings", "Travel")
                checked := model.show_travel
            CheckBox: sw:
                text = QApplication.translate("settings", "Weed lines")
                checked := model.show_weeds
            CheckBox: so:
                text = QApplication.translate("settings", "Origin")
                checked := model.show_origin
            CheckBox: sf:
                text = QApplication.translate("settings", "Feed direction")
                checked := model.show_feed
            CheckBox: sl:
                text = QApplication.translate("settings", "Legend")
                checked := model.show_legend
